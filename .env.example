# Copy file này thành .env rồi dán API key của bạn vào:
#   cp .env.example .env

# ===== Google AI Studio (mặc định) =====
GEMINI_API_KEY=your-google-ai-studio-key-here
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LAB_MODEL=gemini-2.0-flash
LAB_MINI_MODEL=gemini-2.0-flash-lite

# ===== Cách 2: NVIDIA NIM — MIỄN PHÍ (xem LAB_GUIDE.md, Phụ lục B) =====
# Lấy key tại https://build.nvidia.com rồi bỏ comment 4 dòng dưới
# (và comment/xóa các dòng GEMINI ở trên):
# GEMINI_API_KEY=nvapi-your-key-here
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# LAB_MODEL=meta/llama-3.3-70b-instruct
# LAB_MINI_MODEL=meta/llama-3.1-8b-instruct
